# ==========================================
# HirebridgeHR — Environment Variables
# Copy to .env and fill real values
# ==========================================

# DATABASE
DATABASE_URL="postgresql://hirebridge:hirebridge_dev_password@localhost:5432/hirebridge?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-string-min-32-chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_SECRET="change-this-too-another-long-random-string"
JWT_REFRESH_EXPIRES="7d"

# APP
NODE_ENV="development"
API_PORT=4000
API_URL="http://localhost:4000"
WEB_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"

# EMAIL
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@hirebridgehr.com"

# STORAGE
STORAGE_TYPE="local"
STORAGE_LOCAL_PATH="./uploads"
MAX_FILE_SIZE_MB=10

# SUPER ADMIN
SUPER_ADMIN_EMAIL="admin@hirebridgehr.com"
SUPER_ADMIN_PASSWORD="ChangeMe@12345"

# FUTURE
OPENAI_API_KEY=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
